---
import SectionHeader from "../SectionHeader.astro";
import PlaygroundGrid from "../playground/PlaygroundGrid.astro";
import Lightbox from "../playground/Lightbox.astro";
import { playground } from "../../data/home";
import { getPlayground } from "../../lib/content";

const all = await getPlayground();
const items = all.slice(0, 4);
---

{
  items.length > 0 && (
    <section class="container section" aria-labelledby="playground">
      <SectionHeader id="playground" title={playground.title} intro={playground.intro} />
      <PlaygroundGrid items={items} />
      <a class="playground__more" href="/playground">
        See everything in the Playground <span aria-hidden="true">→</span>
      </a>
      <Lightbox />
    </section>
  )
}

<style>
  .playground__more {
    display: inline-block;
    margin-top: var(--space-5);
    padding-block: 10px;
    font-size: var(--fs-small);
    font-weight: 500;
  }
</style>
